POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
# Required. Generate a URL-safe value; never commit the populated .env file.
POSTGRES_PASSWORD=
# Format: postgresql+psycopg://USER:PASSWORD@db:5432/DATABASE
DATABASE_URL=
# Host-only port used by pgAdmin; containers continue to use db:5432.
POSTGRES_HOST_PORT=5432
